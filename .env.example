# Flask
FLASK_DEBUG=true
PORT=5000
FRONTEND_ORIGIN=http://localhost:5173
REQUEST_TIMEOUT_SECONDS=6

# Leave this blank to use the local citysense.db SQLite file.
# For PostgreSQL, set a complete SQLAlchemy URL only in your private .env file
# or in an AWS-managed secret.
DATABASE_URL=

# AWS RDS alternative. These are used only when DATABASE_URL is empty.
RDS_HOSTNAME=
RDS_PORT=5432
RDS_USERNAME=
RDS_PASSWORD=
RDS_DB_NAME=citysense
RDS_SSLMODE=require

# Leave this blank to use two simulated walking routes.
OPENROUTESERVICE_API_KEY=

# Set to false when you want to work fully offline.
USE_LIVE_CITY_DATA=true
