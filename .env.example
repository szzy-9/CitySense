# Server-side HeiGIT key used by Pelias autocomplete and OpenRouteService.
OPENROUTESERVICE_API_KEY=YOUR_HEIGIT_API_KEY

# Leave empty for local SQLite. Render production should use a Neon pooled URL
# that includes sslmode=require. Never commit the real value.
DATABASE_URL=

USE_LIVE_CITY_DATA=true
REQUEST_TIMEOUT_SECONDS=6
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
FLASK_DEBUG=false
PORT=5000
PYTHONUNBUFFERED=1

# Prototype historical-profile confidence thresholds. These require validation.
PREDICTION_MEDIUM_MIN_SAMPLES=12
PREDICTION_HIGH_MIN_SAMPLES=30
PREDICTION_MEDIUM_MAX_CV=1.0
PREDICTION_HIGH_MAX_CV=0.5
PREDICTION_MIN_ALERT_CONFIDENCE=MEDIUM
