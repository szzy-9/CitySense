# Leave blank for the standard local setup and same-origin production deployment.
VITE_API_BASE_URL=

# Optional arrival radius used by the Navigate screen.
VITE_ARRIVAL_DISTANCE_METERS=35

# Optional. Pins Demo Mode to one position instead of drawing a fresh point in
# the Hoddle Grid each time it is switched on from the masthead. Set this when a
# demo has to run the same way twice. Format: "lat,lon".
# VITE_DEMO_ORIGIN=-37.8183,144.9671
